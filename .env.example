# ==============================================================================
# Kairos — Environment Configuration Example
# ==============================================================================
# Kairos is 100% local-first and privacy-focused by default.
# The entire app runs offline out of the box with zero cloud dependencies
# or required API keys.
#
# If you are integrating optional developer tools or self-hosted services
# in a custom build, copy this file to `.env` and fill in your values:
#
#   cp .env.example .env
#
# ==============================================================================

# Optional: Self-hosted analytics (default is disabled)
# KAIROS_ANALYTICS_ENABLED=false
# KAIROS_ANALYTICS_HOST=https://analytics.example.com

# Optional: Automated test / CI screenshot output directory
# KAIROS_ARTIFACT_DIR=screenshots
