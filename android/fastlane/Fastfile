ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"
ENV["FASTLANE_HIDE_CHANGELOG"] = "1"
ENV["FASTLANE_OPT_OUT_USAGE"] = "1"

default_platform(:android)

# ─────────────────────────────────────────────────────────────────────────────
# Automatic Version & Build Number Manager
# ─────────────────────────────────────────────────────────────────────────────

# Computes the next version name adhering to:
# 1.0.1 -> 1.0.2 ... 1.0.20 -> 1.1.1 -> 1.1.2 ... 1.1.20 -> 1.2.1 ...
def calculate_next_version_name(current_version_name)
  parts = current_version_name.to_s.split(".").map(&:to_i)
  major = parts[0] || 1
  minor = parts[1] || 0
  patch = parts[2] || 0

  next_patch = patch + 1
  next_minor = minor
  next_major = major

  # Roll over to next minor once patch exceeds 20
  if next_patch > 20
    next_patch = 1
    next_minor = minor + 1
    if next_minor > 20
      next_minor = 0
      next_major = major + 1
    end
  end

  "#{next_major}.#{next_minor}.#{next_patch}"
end

def get_target_version_and_build(options = {})
  root_dir = File.expand_path("../..", __dir__)
  pubspec_path = File.join(root_dir, "pubspec.yaml")
  UI.user_error!("pubspec.yaml not found at #{pubspec_path}") unless File.exist?(pubspec_path)

  content = File.read(pubspec_path)
  match = content.match(/^version:\s*([^\s+]+)\+(\d+)/)
  UI.user_error!("Could not parse version in #{pubspec_path}") unless match

  current_version_name = match[1]
  current_build = match[2].to_i

  # Compute default next values
  default_next_version_name = calculate_next_version_name(current_version_name)
  next_build = current_build + 1

  target_build = if options[:build_number]
    options[:build_number].to_i
  elsif options[:version_code]
    options[:version_code].to_i
  elsif UI.interactive? && !options[:non_interactive]
    prompt_val = UI.input("Enter build number (current: #{current_build}, default: #{next_build}):").strip
    prompt_val.empty? ? next_build : prompt_val.to_i
  else
    next_build
  end

  target_build = next_build if target_build.nil? || target_build <= 0

  target_version_name = if options[:version_name]
    options[:version_name].to_s.strip
  elsif options[:version]
    options[:version].to_s.strip
  elsif UI.interactive? && !options[:non_interactive]
    prompt_val = UI.input("Enter version name (current: #{current_version_name}, default: #{default_next_version_name}):").strip
    prompt_val.empty? ? default_next_version_name : prompt_val
  else
    default_next_version_name
  end

  # Update pubspec.yaml in-place
  new_version_line = "version: #{target_version_name}+#{target_build}"
  updated_content = content.sub(/^version:\s*[^\s+]+(?:\+\d+)?/, new_version_line)
  File.write(pubspec_path, updated_content)

  UI.success("📌 Updated pubspec.yaml version to #{target_version_name}+#{target_build}")
  [target_build, target_version_name]
end

def get_target_build_number(options = {})
  build_num, _ = get_target_version_and_build(options)
  build_num
end

def get_full_version_string
  pubspec_path = File.expand_path("../../pubspec.yaml", __dir__)
  if File.exist?(pubspec_path)
    content = File.read(pubspec_path)
    if (match = content.match(/^version:\s*([^\s]+)/))
      return match[1]
    end
  end
  "1.0.0+1"
end

def build_flutter_aab(build_num, version_name = nil)
  root_dir = File.expand_path("../..", __dir__)
  UI.message("Building Flutter release appbundle from: #{root_dir}")
  
  cmd = "flutter build appbundle --release --build-number=#{build_num}"
  cmd += " --build-name=#{version_name}" if version_name && !version_name.to_s.empty?

  Dir.chdir(root_dir) do
    sh(cmd)
  end

  aab_path = File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__)
  unless File.exist?(aab_path)
    UI.user_error!("Could not find built appbundle at: #{aab_path}")
  end
  
  aab_path
end

def commit_and_tag_release(track_name, build_num, version_name = nil)
  root_dir = File.expand_path("../..", __dir__)
  version_str = version_name ? "#{version_name}+#{build_num}" : get_full_version_string
  tag_name = "v#{version_str}"

  UI.message("Creating Git release commit and tag: #{tag_name}")
  Dir.chdir(root_dir) do
    sh("git add pubspec.yaml android/fastlane/metadata/android/en-US/changelogs/#{build_num}.txt")
    sh("git commit -m \"chore(release): bump version to #{version_str} and deploy to #{track_name}\"")
    sh("git tag -a \"#{tag_name}\" -m \"Release #{version_str} (#{track_name})\"")
    sh("git push origin --follow-tags")
  end
  UI.success("Successfully pushed release commit and tag to remote!")
rescue => e
  UI.important("Git commit/tagging skipped: #{e.message}")
end

platform :android do
  lane :build do |options|
    build_num, version_name = get_target_version_and_build(options)
    build_flutter_aab(build_num, version_name)
  end

  lane :internal do |options|
    deploy_to_track('internal', options)
  end

  lane :closed do |options|
    track_name = options[:track] || 'alpha'
    deploy_to_track(track_name, options)
  end

  lane :beta do |options|
    deploy_to_track('beta', options)
  end

  lane :production do |options|
    deploy_to_track('production', options)
  end

  def deploy_to_track(track_name, options)
    build_num, version_name = get_target_version_and_build(options)
    aab_path = build_flutter_aab(build_num, version_name)
    mapping_path = File.expand_path("../../build/app/outputs/mapping/release/mapping.txt", __dir__)

    # Write changelog
    changelogs_dir = File.expand_path("metadata/android/en-US/changelogs", __dir__)
    FileUtils.mkdir_p(changelogs_dir)
    changelog_file = File.join(changelogs_dir, "#{build_num}.txt")
    if options[:release_notes] || options[:changelog]
      changelog_content = options[:release_notes] || options[:changelog]
      File.write(changelog_file, changelog_content)
      UI.success("Generated changelog for build #{build_num}")
    elsif !File.exist?(changelog_file)
      changelog_content = [
        "• Performance enhancements and bug fixes.",
        "• UI/UX optimizations and stability improvements."
      ].join("\n")
      File.write(changelog_file, changelog_content)
      UI.success("Generated default changelog for build #{build_num}")
    else
      UI.success("Using existing changelog at #{changelog_file}")
    end

    upload_params = {
      track: track_name,
      aab: aab_path,
      json_key: File.expand_path("api-key.json", __dir__),
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      timeout: 600,
      changes_not_sent_for_review: false,
      rescue_changes_not_sent_for_review: true
    }
    upload_params[:mapping] = mapping_path if File.exist?(mapping_path)

    upload_to_play_store(upload_params)
    UI.success("Successfully uploaded Build #{build_num} (#{version_name}) to Google Play track [#{track_name}]! 🎉")

    if options[:git] == true || options[:git_tag] == true
      commit_and_tag_release(track_name, build_num, version_name)
    end
  end
end
