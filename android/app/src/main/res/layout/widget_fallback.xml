<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fallback_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/widget_background_dark">

    <ImageView
        android:id="@+id/fallback_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@mipmap/ic_launcher"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/fallback_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kairos"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#F4EFE8" />

    <TextView
        android:id="@+id/fallback_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to open"
        android:textSize="11sp"
        android:textColor="#9E968D"
        android:layout_marginTop="2dp" />
</LinearLayout>
