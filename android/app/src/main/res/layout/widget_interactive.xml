<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Header: Next Alarm & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/alarm_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEXT ALARM"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#C85A32"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/alarm_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:30"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#14120E"
                    android:includeFontPadding="false"
                    android:layout_marginTop="1dp" />

                <TextView
                    android:id="@+id/alarm_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Morning Run &amp; Coffee"
                    android:textSize="11.5sp"
                    android:fontFamily="serif"
                    android:textColor="#68625B"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_alarm_toggle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="ON"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:background="@drawable/widget_pill_accent" />
        </LinearLayout>

        <ImageView
            android:id="@+id/interactive_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F000000"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Focus Streak & Quick Timer Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Focus streak artwork from Flutter -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/focus_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOCUS STREAK"
                    android:textSize="9.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#68625B"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp" />

                <ImageView
                    android:id="@+id/focus_streak_bars"
                    android:layout_width="140dp"
                    android:layout_height="22dp"
                    android:scaleType="fitStart" />
            </LinearLayout>

            <!-- Quick 25m focus start button -->
            <TextView
                android:id="@+id/btn_quick_focus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="Focus 25m"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#14120E"
                android:clickable="true"
                android:background="@drawable/widget_chip_dark"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
