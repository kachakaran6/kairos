<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/world_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WORLD CLOCK"
            android:textSize="10.5sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#C85A32"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- City 1 -->
            <LinearLayout
                android:id="@+id/city_card_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="@drawable/widget_surface_dark"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/city_name_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="London"
                    android:textSize="11.5sp"
                    android:fontFamily="serif"
                    android:textColor="#68625B" />

                <TextClock
                    android:id="@+id/city_clock_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:timeZone="Europe/London"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#14120E"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- City 2 -->
            <LinearLayout
                android:id="@+id/city_card_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="@drawable/widget_surface_dark"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp">

                <TextView
                    android:id="@+id/city_name_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New York"
                    android:textSize="11.5sp"
                    android:fontFamily="serif"
                    android:textColor="#68625B" />

                <TextClock
                    android:id="@+id/city_clock_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:timeZone="America/New_York"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#14120E"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- City 3 -->
            <LinearLayout
                android:id="@+id/city_card_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="@drawable/widget_surface_dark"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/city_name_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tokyo"
                    android:textSize="11.5sp"
                    android:fontFamily="serif"
                    android:textColor="#68625B" />

                <TextClock
                    android:id="@+id/city_clock_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:timeZone="Asia/Tokyo"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#14120E"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
