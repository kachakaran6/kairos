<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background_dark">

    <TextView
        android:id="@+id/world_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WORLD CLOCK"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#E8895A"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- City 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/widget_surface_dark"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/city_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="London"
                android:textSize="12sp"
                android:textColor="#9E968D" />

            <TextClock
                android:id="@+id/city_clock_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:timeZone="Europe/London"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#F4EFE8" />
        </LinearLayout>

        <!-- City 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/widget_surface_dark"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/city_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New York"
                android:textSize="12sp"
                android:textColor="#9E968D" />

            <TextClock
                android:id="@+id/city_clock_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:timeZone="America/New_York"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#F4EFE8" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <!-- City 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/widget_surface_dark"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/city_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tokyo"
                android:textSize="12sp"
                android:textColor="#9E968D" />

            <TextClock
                android:id="@+id/city_clock_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:timeZone="Asia/Tokyo"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#F4EFE8" />
        </LinearLayout>

        <!-- City 4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/widget_surface_dark"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/city_name_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mumbai"
                android:textSize="12sp"
                android:textColor="#9E968D" />

            <TextClock
                android:id="@+id/city_clock_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:timeZone="Asia/Kolkata"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#F4EFE8" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
