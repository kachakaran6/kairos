<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="18dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/moment_text_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <!-- Category Badge -->
            <TextView
                android:id="@+id/moment_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRAVEL"
                android:textSize="10.5sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#C85A32"
                android:letterSpacing="0.08" />

            <!-- Main Confident Counter Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/moment_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42"
                    android:textSize="44sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#14120E"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/moment_separator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#8A847C"
                    android:includeFontPadding="false"
                    android:visibility="gone" />

                <Chronometer
                    android:id="@+id/moment_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#14120E"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Moment Title -->
            <TextView
                android:id="@+id/moment_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trip to Kyoto"
                android:textSize="15sp"
                android:fontFamily="serif"
                android:textColor="#14120E"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:layout_marginTop="2dp" />

            <!-- Subtitle or date -->
            <TextView
                android:id="@+id/moment_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Autumn exploration"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif"
                android:textColor="#68625B"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Clean Sharp Progress Arc Canvas -->
        <ImageView
            android:id="@+id/moment_progress_ring"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
</FrameLayout>
